{
  "name": "vite-vue-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "generate:api": "orval --config orval.config.ts",
    "check-localization-files": "tsx scripts/check-localization.ts",
    "check-phrases": "tsx scripts/translate-untranslated.ts",
    "check-typescript-errors-tsc": "tsc --noEmit",
    "check-typescript-errors-vue": "vue-tsc --noEmit",
    "lint": "eslint src/**/*.{ts,vue} --ext .ts,.vue",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@folks-router/js-sdk": "^0.5.1",
    "@microsoft/signalr": "^10.0.11",
    "@txnlab/use-wallet": "^5.0.1",
    "@txnlab/use-wallet-defly": "^5.0.1",
    "@txnlab/use-wallet-exodus": "^5.0.1",
    "@txnlab/use-wallet-kibisis": "^5.0.1",
    "@txnlab/use-wallet-lute": "^5.0.0",
    "@txnlab/use-wallet-pera": "^5.0.1",
    "@txnlab/use-wallet-vue": "^5.0.1",
    "algosdk": "^3.8.0",
    "arc14": "^1.0.4",
    "arc76": "^1.0.2",
    "axios": "^1.20.0",
    "biatec-router": "^1.0.1",
    "biatec-wallet-use-wallet-client": "^0.3.1",
    "buffer": "^6.0.3",
    "uuidv7": "^1.2.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.3.1",
    "whatamesh": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "orval": "^8.40.0",
    "prettier": "^3.9.9",
    "prettier-eslint": "^17.1.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  }
}
