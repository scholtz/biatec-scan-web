{
  "name": "vite-vue-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "generate:api": "orval --config orval.config.ts",
    "check-localization-files": "tsx scripts/check-localization.ts",
    "check-phrases": "tsx scripts/translate-untranslated.ts",
    "check-typescript-errors-tsc": "tsc --noEmit",
    "check-typescript-errors-vue": "vue-tsc --noEmit",
    "lint": "eslint src/**/*.{ts,vue} --ext .ts,.vue",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.0",
    "algosdk": "^3.6.0",
    "arc14": "^1.0.4",
    "arc76": "^1.0.2",
    "axios": "^1.19.0",
    "buffer": "^6.0.3",
    "uuidv7": "^1.2.1",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "whatamesh": "^0.2.0"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jiti": "^2.7.0",
    "orval": "^8.23.0",
    "prettier": "^3.9.6",
    "prettier-eslint": "^17.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  }
}
