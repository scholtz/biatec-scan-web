server {
    listen       8080;
    server_name  localhost;
    port_in_redirect off;

    access_log /dev/stdout;
    error_log /dev/stderr;

    # Security headers (AUDIT-2026-07-20-01). Read-only explorer with no known XSS sink
    # today, but these are the primary defense-in-depth control against any future one,
    # and they protect the localStorage session id (see authService.ts) from exfiltration.
    #
    # CSP_CONNECT_SRC is substituted at container start (nginx's built-in
    # docker-entrypoint envsubst-on-templates step) from a plain env var, so
    # the same image can be deployed to any network (mainnet, testnet, later
    # voi/aramid) by only changing the container's environment - see
    # k8s/*/deployment-fe.yaml. It must be kept in sync with the VITE_* API/
    # algod/indexer URLs baked into the JS bundle at build time for that
    # same environment.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' ${CSP_CONNECT_SRC}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location ~* \.(manifest|html|xml|json)$ {
        root   /app;
        index  index.html;
        expires 1m;
    }

    location ~* \.(css|js|map|ttf)$ {
        # cache css and js files as they have hash inside filename
        root   /app;
        access_log off;
        expires max;
    }

    location ~* \.(svg|png|xcf|ico)$ {
        # cache css and js files as they have hash inside filename
        root   /app;
        access_log off;
        expires 7d;
    }

    location ~* \.(txt)$ {
        # log robots.txt requests, but cache them
        root   /app;
        expires 30d;
    }

    # Polled frequently by k8s startup/readiness/liveness probes and the external uptime
    # monitor, so it's excluded from access_log. Static SPA has no backend dependency to
    # degrade - nginx serving this response at all is itself the "Healthy" signal.
    location = /health {
        access_log off;
        default_type application/json;
        return 200 '{"status":"Healthy"}';
    }

    # Standard SPA configuration
    location / {
        root   /app;
        try_files $uri /index.html;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
